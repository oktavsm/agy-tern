{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2024"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@stencil-hq/tern",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun", "node"]
  },
  "include": ["src", "test"]
}
