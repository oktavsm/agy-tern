{
  "name": "agy-tern",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "oktavsm",
  "homepage": "https://github.com/oktavsm/agy-tern#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/oktavsm/agy-tern.git"
  },
  "bugs": {
    "url": "https://github.com/oktavsm/agy-tern/issues"
  },
  "keywords": [
    "antigravity",
    "agy",
    "acp",
    "tern",
    "terminal",
    "tui"
  ],
  "description": "A native Tern frontend for the official Antigravity CLI over ACP",
  "bin": { "agy-tern": "dist/cli.js" },
  "scripts": {
    "start": "bun src/cli.tsx",
    "doctor": "bun run src/cli.tsx --doctor",
    "build": "rm -rf dist && bun build src/cli.tsx --target=bun --outdir dist --splitting",
    "bench": "bun run scripts/bench.ts",
    "setup": "bash ./scripts/install.sh",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "engines": { "bun": ">=1.2.22", "node": ">=22" },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.6.0",
    "@stencil-hq/tern": "0.2.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.11",
    "@types/node": "24.10.1",
    "typescript": "6.0.3"
  }
}
